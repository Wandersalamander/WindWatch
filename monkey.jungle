project.manifest = manifest.xml
base.sourcePath = source;test

# Launcher icons come in the exact size of each device, see resources-icon-<size>
base.resourcePath = resources;resources-hint;resources-icon-40

# Monochrome displays cannot tell the temperature colors apart, see Colors.mc
base.excludeAnnotations = monochromeDisplay
descentg1.excludeAnnotations = colorDisplay
instinct2.excludeAnnotations = colorDisplay
instinct2s.excludeAnnotations = colorDisplay
instinct2x.excludeAnnotations = colorDisplay
instinctcrossover.excludeAnnotations = colorDisplay

# These devices predate the personality icons used by the ActionMenu hint
descentmk2.resourcePath = resources;resources-nohint;resources-icon-40
descentmk2s.resourcePath = resources;resources-nohint;resources-icon-40
fr745.resourcePath = resources;resources-nohint;resources-icon-40
fr945.resourcePath = resources;resources-nohint;resources-icon-40

# Devices whose launcher icon is not 40x40
