# Single source of truth for the Connect IQ toolchain, used by CI and scripts/build_iq.sh.
# When bumping: change both lines together. The image tag pins the SDK version
# (see CONNECT_IQ_VERSION in https://github.com/matco/connectiq-tester/blob/<tag>/Dockerfile).
CONNECTIQ_IMAGE=ghcr.io/matco/connectiq-tester:v2.10.0
CONNECTIQ_SDK_VERSION=9.2.0
